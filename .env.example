# site-b2b-intel — environment configuration
# Copy to .env and fill in values. Never commit .env.

# Path to the SQLite database. Default: ~/.local/share/b2b-intel/b2b-intel.db
# B2B_INTEL_DB_PATH=

# Comma-separated list of upstream DNS resolvers, tried in order.
# Default: 1.1.1.1,8.8.8.8,9.9.9.9
# B2B_INTEL_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9

# Per-resolver max queries per second. Default: 5
# B2B_INTEL_RATE_LIMIT_QPS=5

# DNS query timeout in seconds. Default: 5.0
# B2B_INTEL_DNS_TIMEOUT=5.0
